# =================================================================
# ABAC Engine for Enterprise Applications - Root Environment Variables
# Copy this file to .env or configure in respective backend/ and frontend/ folders
# =================================================================

# --- Backend Configuration ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-abac-engine-secret-key-phase2-replace-in-production
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL Database (Phase 2)
# Supported schemes: postgresql://, postgresql+psycopg://, postgres://
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://127.0.0.1:5000/api
