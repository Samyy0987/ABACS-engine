# =================================================================
# ABAC Engine for Enterprise Applications - Backend Environment Variables
# Copy this file to backend/.env for local configuration.
# Never commit real credentials or secrets to version control.
# =================================================================

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-abac-engine-secret-key-phase2-replace-in-production
HOST=127.0.0.1
PORT=5000

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =================================================================
# Supabase PostgreSQL Database Configuration
# =================================================================
# Supported URL formats:
# 1. Direct Connection (Port 5432):
#    postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# 2. Transaction Pooler / Session Pooler (Port 6543 / 5432):
#    postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# 3. Explicit Driver Scheme (psycopg v3):
#    postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# NOTE: Legacy 'postgres://' URLs are automatically normalized to 'postgresql://'.
# Leave empty to keep legacy database in unconfigured mode.
DATABASE_URL=

# =================================================================
# Oracle APEX / ORDS REST API Configuration (Phase B)
# =================================================================
# The HTTPS Base URL of your enabled ORDS module.
# Format: https://<apex-host>/ords/<schema>/abac/v1
# Example: https://oracleapex.example.com/ords/my_workspace/abac/v1
ORDS_BASE_URL=

# Authentication Mode: 'oauth2', 'bearer', 'basic', or 'none'
# Use 'none' during initial local dev or if ORDS endpoints are public/unprotected.
# Use 'oauth2' with Oracle ORDS client credentials for production environments.
ORDS_AUTH_MODE=none

# OAuth2 Client Credentials (required if ORDS_AUTH_MODE=oauth2)
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=
# Format: https://<apex-host>/ords/<schema>/oauth/token
ORDS_TOKEN_URL=

# Static Bearer Token (optional, if ORDS_AUTH_MODE=bearer)
ORDS_BEARER_TOKEN=

# Basic Auth Credentials (optional, if ORDS_AUTH_MODE=basic)
ORDS_BASIC_USERNAME=
ORDS_BASIC_PASSWORD=

# Timeout & Retry Settings
ORDS_TIMEOUT_SECONDS=5.0
ORDS_MAX_RETRIES=2
